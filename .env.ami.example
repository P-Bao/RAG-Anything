# AMI multimodal RAG service (package ami_rag). Copy thanh .env. Xem docs/ami_service.md.
# --- LLM (qwen-selfhost, OpenAI-compatible): describe_func / answer_func ---
QWEN_LLM_BASE_URL=http://vllm:8000/v1
QWEN_LLM_MODEL=Qwen/Qwen3-32B
QWEN_LLM_API_KEY=
# De trong = dung chung QWEN_LLM_MODEL cho describe (VLM)
QWEN_VLM_MODEL=

# --- Embedding server (may B, qwen-embedding-server; client chi la HTTP) ---
EMBED_SERVER_URL=http://localhost:8007
# Chi tu env, khong ghi vao file trong git
EMBED_SERVER_TOKEN=
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
# De xac minh voi server luc handshake; dim thuc te do server quyet dinh
EMBED_DIM=2048
EMBED_TIMEOUT=60
EMBED_BATCH_SIZE=32
EMBED_MAX_CONCURRENCY=4
EMBED_RETRIES=3
# Cache embedding SQLite o may A (tiet kiem luot goi mang)
EMBED_CACHE_ENABLED=true
EMBED_CACHE_PATH=./embed_cache.db

# --- Storage: MongoDB. RAG dung chung organization_db; collection RAG co tien to "multimodal_".
#     Chi DOC documents/organization_units/users. ---
MONGO_URI=mongodb://localhost:27017/?directConnection=true
RAG_DB=organization_db
RAG_DOCUMENTS_COLLECTION=multimodal_rag_documents
ORG_DB=organization_db
DOC_COLLECTION=documents

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Workspace = tien to collection Qdrant: {WORKSPACE}__{embed_model_slug}__{CHUNKER_VERSION}
WORKSPACE=multimodal

# --- Chunking ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=100

# --- Parser (MinerU) / vision ---
PARSER=mineru
PARSE_METHOD=auto
PARSER_OUTPUT_DIR=./output
# MinerU. Do (Colab T4, 10 trang): pipeline GPU dinh ~3.3 GiB (~1.1 GiB khi VIRTUAL_VRAM=4), ~5 s/trang;
# CPU ~27 s/trang; hybrid-engine ~14.5 GiB, cham ~6 lan -> luon dat MINERU_BACKEND=pipeline.
MINERU_BACKEND=pipeline
# cuda | cuda:0 | cpu ; de trong = tu nhan (truyen qua MINERU_DEVICE_MODE)
MINERU_DEVICE=
# GB VRAM ma MinerU duoc phep "nghi" minh co (nho = batch nho = it VRAM, cham hon ~15%). 0 = tu nhan
MINERU_VIRTUAL_VRAM_SIZE=4
# Goi y ngon ngu OCR (ch, en, latin, ...); de trong = mac dinh MinerU
MINERU_LANG=
# huggingface | modelscope | local ; de trong = mac dinh
MINERU_SOURCE=
# Giay toi da cho moi tai lieu; 0 = khong gioi han
MINERU_TIMEOUT=1800

# --- Queue (Redis Streams) ---
REDIS_URL=redis://localhost:6379/0
RAG_STREAM=rag:ingest
RAG_CONSUMER_GROUP=ami-rag
RAG_CONSUMER_NAME=
# WORKER_ENABLED=true: API nhung worker (metrics ingest chung /metrics cua API).
# docker-compose.ami.yml ep false va chay ami-rag-worker rieng.
WORKER_ENABLED=true
WORKER_BATCH=10
WORKER_POLL_BLOCK_MS=5000
WORKER_MAX_DELIVERY=3
# Message loi duoc giao lai sau khoang idle nay (ms); > thoi gian parse MinerU dai nhat
WORKER_RETRY_IDLE_MS=600000
# Prometheus /metrics cua worker chay rieng (ami-rag-worker)
WORKER_METRICS_PORT=9109

# --- Rerank (external service, bge-reranker-v2-m3) ---
RERANK_BASE_URL=http://localhost:8010
RERANK_TOP_K=5
RERANK_TIMEOUT=60

# --- Retrieval: `top_k` cua request = so doc tra ve cuoi cung (mac dinh RERANK_TOP_K).
# Vector search lay max(RETRIEVAL_CHUNK_TOP_K, top_k*RETRIEVAL_OVERFETCH) ung vien de rerank ---
RETRIEVAL_CHUNK_TOP_K=40
RETRIEVAL_OVERFETCH=4

# --- MinIO (file goc docs/pdf, anh/bang da tach, anh crawl) ---
# Asset sau parse: {ASSET_PREFIX}/{doc_id}/ (anh + content_list.json). MINIO_PRESIGN_EXPIRES (giay) cho artifact_url/file_url.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=ami-data-documents
MINIO_SECURE=false
CRAWL_IMAGES_PREFIX=crawl-images
CRAWL_IMAGES_ENABLED=false
MINIO_PRESIGN_EXPIRES=3600
ASSET_PREFIX=rag-assets

# --- API (port 8009 de khong xung dot voi legacy conv-rag :8005) ---
API_HOST=0.0.0.0
API_PORT=8009
# RAG_API_KEY: bearer cho /v2/rag va /admin; de trong = khong auth. /metrics khong can key.
RAG_API_KEY=

# --- Observability (Prometheus /metrics luon bat; tracing OTLP/HTTP tuy chon) ---
# Cac bien OTEL_*/TRACE_OUTPUT_MAX_LEN doc truc tiep tu os.environ (khong qua Settings): docker compose
# nap .env vao container; chay local thi phai export trong shell.
# De trong = tracing tat (span no-op). Vi du Tempo NodePort tren host:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:32706
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=multimodal-rag-retrieval
# Gioi han ky tu cua event documents_json trong span (0 = khong cat). Mac dinh 2000000.
TRACE_OUTPUT_MAX_LEN=

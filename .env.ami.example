# AMI multimodal RAG service (package ami_rag). Copy thanh .env. Xem docs/ami_service.md.
# --- LLM profile: gemini (default) | qwen-selfhost (du phong) ---
LLM_PROFILE=gemini
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# Du phong: Qwen self-host (vLLM, OpenAI-compatible)
QWEN_LLM_BASE_URL=http://vllm:8000/v1
QWEN_LLM_MODEL=Qwen/Qwen3-32B
QWEN_LLM_API_KEY=
QWEN_EMBED_BASE_URL=http://vllm:8000/v1
QWEN_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
QWEN_EMBED_API_KEY=
QWEN_EMBED_DIM=1024

# --- Storage: MongoDB (RAG_DB cho LightRAG + rag_documents; organization_db chi doc) ---
MONGO_URI=mongodb://localhost:27017/?directConnection=true
RAG_DB=raganything_db
RAG_DOCUMENTS_COLLECTION=rag_documents
ORG_DB=organization_db
DOC_COLLECTION=documents

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Workspace LightRAG/Qdrant (doc lap voi luong cu); WORKING_DIR = thu muc lam viec cua LightRAG
WORKSPACE=ami_mm
WORKING_DIR=./rag_storage

# --- Chunking / extraction ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
MAX_GLEANING=1
SUMMARY_LANGUAGE=Tiếng Việt

# --- Parser (MinerU) / vision ---
PARSER=mineru
PARSE_METHOD=auto
PARSER_OUTPUT_DIR=./output
# De trong = dung chung model LLM
GEMINI_VISION_MODEL=
QWEN_VLM_MODEL=

# --- Queue (Redis Streams) ---
REDIS_URL=redis://localhost:6379/0
RAG_STREAM=rag:ingest
RAG_CONSUMER_GROUP=ami-rag
RAG_CONSUMER_NAME=
# WORKER_ENABLED=true: API nhung worker (metrics ingest chung /metrics cua API).
# docker-compose.ami.yml ep false va chay ami-rag-worker rieng.
WORKER_ENABLED=true
WORKER_BATCH=10
WORKER_POLL_BLOCK_MS=5000
WORKER_MAX_DELIVERY=3
# Message loi duoc giao lai sau khoang idle nay (ms); > thoi gian parse MinerU dai nhat
WORKER_RETRY_IDLE_MS=600000
# Prometheus /metrics cua worker chay rieng (ami-rag-worker)
WORKER_METRICS_PORT=9109

# --- Rerank (external service, bge-reranker-v2-m3) ---
RERANK_BASE_URL=http://localhost:8010
RERANK_TOP_K=5
RERANK_TIMEOUT=60

# --- Retrieval (top_k mac dinh / chunk_top_k truyen vao aquery_data; RERANK_TOP_K = so doc tra ve) ---
RETRIEVAL_TOP_K=40
RETRIEVAL_CHUNK_TOP_K=40

# --- MinIO (file goc docs/pdf, anh/bang da tach, anh crawl) ---
# Asset sau parse: {ASSET_PREFIX}/{doc_id}/ (anh + content_list.json). MINIO_PRESIGN_EXPIRES (giay) cho artifact_url/file_url.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=ami-data-documents
MINIO_SECURE=false
CRAWL_IMAGES_PREFIX=crawl-images
CRAWL_IMAGES_ENABLED=false
MINIO_PRESIGN_EXPIRES=3600
ASSET_PREFIX=rag-assets

# --- API (port 8009 de khong xung dot voi legacy conv-rag :8005) ---
API_HOST=0.0.0.0
API_PORT=8009
# RAG_API_KEY: bearer cho /v2/rag va /admin; de trong = khong auth. /metrics khong can key.
RAG_API_KEY=

# --- Observability (Prometheus /metrics luon bat; tracing OTLP/HTTP tuy chon) ---
# Cac bien OTEL_*/TRACE_OUTPUT_MAX_LEN doc truc tiep tu os.environ (khong qua Settings): docker compose
# nap .env vao container; chay local thi phai export trong shell.
# De trong = tracing tat (span no-op). Vi du Tempo NodePort tren host:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:30749
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=multimodal-rag-retrieval
# Gioi han ky tu cua event documents_json trong span (0 = khong cat). Mac dinh 2000000.
TRACE_OUTPUT_MAX_LEN=

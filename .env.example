# KG branch (LightRAG 1.5.7 + Qwen3.5 + nemotron embed + BGE rerank).
# Copy thanh .env. Chi tiet: docs/kg_branch.md.
# Docker: host = ten container tren network ami-network (vd minio:9000).

# --- LLM: Qwen3.5 (OpenAI-compatible, vLLM) ---
QWEN_LLM_BASE_URL=http://localhost:8000/v1
QWEN_LLM_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
QWEN_LLM_API_KEY=EMPTY

# Song song LLM theo role (mặc định 4). Tang khi GPU cho phep.
EXTRACT_MAX_ASYNC_LLM=4
KEYWORD_MAX_ASYNC_LLM=4

# --- Embedding: nemotron gateway (may B, /health + /v1/embeddings) ---
NEMOTRON_EMBED_URL=http://localhost:8080
NEMOTRON_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
NEMOTRON_EMBED_BATCH_SIZE=16
NEMOTRON_EMBED_MAX_CONCURRENCY=4

# --- Rerank: BGE legacy (:8010, text-only). DE RONG = tat rerank ---
RERANK_BASE_URL=http://localhost:8010
# So vector candidate truoc rerank. Rerank thanh cong tra bao nhieu chunk
# thi API tra bay nhieu chunk.
RETRIEVAL_CANDIDATES=20
# Chi dung cho fallback khi rerank tat/loi.
RERANK_TOP_K=5
RERANK_TIMEOUT=60
# Floor diem rerank (chunk yeu bi vut). 0 = giu tat ca ket qua rerank.
MIN_RERANK_SCORE=0

# --- Caption anh (Gemini qua OpenAI-compatible) — chi khi doc CHUA co
# caption trong MinIO artifacts. Rong = khong caption, chi dung caption reuse.
CAPTION_LLM_API_KEY=
CAPTION_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CAPTION_LLM_MODEL=gemini-3.5-flash-lite
CAPTION_LLM_LANGUAGE=vi
CAPTION_LLM_TIMEOUT=120
CAPTION_LLM_MAX_CONCURRENCY=4
CAPTION_LLM_RETRIES=2

# --- MinIO cua ami-multimodal-retrieval (CHI DOC: content_list + descriptions) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=ami-data-documents
MINIO_SECURE=false
ASSET_PREFIX=rag-assets

# --- Mongo registry (CHI DOC) - danh sach document production upload ---
MONGO_URI=mongodb://localhost:27017
ORG_DB=organization_db
DOC_COLLECTION=documents

# --- Parse: MinerU (layout + anh) - doc env rieng cua mineru ---
PARSE_METHOD=auto
# backend_data = thay text/table bang pdfplumber/PyMuPDF + OCR service;
# mineru = giu nguyen output MinerU (escape hatch khi OCR service khong song)
PARSE_TEXT_SOURCE=backend_data
MINERU_BACKEND=
MINERU_LANG=
MINERU_SOURCE=
MINERU_TIMEOUT=0
MINERU_DEVICE=
MINERU_VIRTUAL_VRAM_SIZE=0

# --- OCR service (Vintern, parse text/bang cho PARSE_TEXT_SOURCE=backend_data) ---
OCR_SERVICE_URL=http://171.226.10.153:12006
OCR_SERVICE_TIMEOUT=300
OCR_TABLE_ENDPOINT=/api/v1/raw_miner_ocr/qwen
OCR_TEXT_ENDPOINT=/api/v1/hierarchy-parse
# Fallback khi OCR service loi/timeout/tra rong. Tat fallback = ENABLED=false
# hoac URL rong; token chi la bearer tuy chon.
OCR_FALLBACK_ENABLED=true
OCR_FALLBACK_URL=http://localhost:8090
OCR_FALLBACK_MODEL=5CD-AI/Vintern-1B-v3_5
OCR_FALLBACK_TOKEN=
OCR_FALLBACK_TIMEOUT=300
OCR_FALLBACK_RETRIES=1
OCR_FALLBACK_ON_EMPTY=true
# rong = tat fallback (khac voi khong dat = text,table)
OCR_FALLBACK_MODES=text,table

# --- API server (kg-api, port 8009 = port cu cua ami-multimodal-retrieval) ---
API_HOST=0.0.0.0
API_PORT=8009
# Bearer key cho /v2/rag/* (Authorization: Bearer <key>). Rong = khong bat auth.
RAG_API_KEY=
# Collection trang thai ingest (RIENG, khong dung multimodal_rag_documents).
# Khong co MONGO_URI -> fallback file JSON trong KG_WORKING_DIR.
KG_STATE_COLLECTION=kg_rag_documents

# --- Hang doi job (worker kg-rag thuong tru) ---
# Co REDIS_URL -> API chi enqueue (Redis Stream), worker kg-rag chay job.
# Rong -> API tu chay job trong process (che do 1 container, dev).
# Redis can bat persistence (AOF/RDB) neu khong muon mat job khi Redis restart.
REDIS_URL=
KG_JOB_STREAM=kg:ingest
KG_JOB_GROUP=kg-workers
# Ten consumer (mac dinh kg-<hostname>-<pid>); dat co dinh khi muon theo doi 1 worker.
KG_WORKER_NAME=
# Reclaim job treo (worker bi kill giua job) khi worker khoi dong lai.
KG_WORKER_STALE_SECONDS=600
# Thoi gian block moi lan cho job (ms).
KG_WORKER_POLL_MS=5000

# --- KG storage file-based (NanoVectorDB + graphml) ---
KG_WORKING_DIR=./rag_storage
